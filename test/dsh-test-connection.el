(ert-deftest dsh-emacs-test-connection-failure-categories-and-origin-lifetime ()
  :tags '(dsh-unit)
  (dolist (failure '(authentication timeout origin-closed))
    (dsh-test--connection-environment
     (lambda ()
       (let ((origin (generate-new-buffer " *failure-origin*"))
             (calls 0) response receive result)
         (cl-letf (((symbol-function 'url-retrieve)
                    (lambda (_url callback &rest _)
                      (setq receive callback response (generate-new-buffer " *failure-auth*")))))
           (with-current-buffer origin
             (dsh-emacs-connect "http://a.example" :token "explicit"
                                :callback (lambda (ok value)
                                            (should-not ok)
                                            (setq result value)
                                            (cl-incf calls))))
           (pcase failure
             ('authentication
              (with-current-buffer response
                (setq-local url-http-response-status 401)
                (insert "HTTP/1.1 401\n\n")
                (funcall receive nil)))
             ('timeout (dsh-emacs--connection-check dsh-emacs--connection-attempt 0))
             ('origin-closed
              ;; Simulate a temporary buffer whose kill hooks are inhibited.
              (with-current-buffer origin (let ((kill-buffer-hook nil)) (kill-buffer origin)))
              (dsh-emacs--connection-check dsh-emacs--connection-attempt most-positive-fixnum)))
           (should (eq dsh-emacs--connection-status 'failed))
           (should (eq (plist-get dsh-emacs--connection-error :code) failure))
           (should-not (buffer-live-p response))
           (should-not dsh-emacs--connection-attempt)
           (should (= calls (if (eq failure 'origin-closed) 0 1)))
           (when result (should-not (string-match-p "explicit" (prin1-to-string result))))))))))

(ert-deftest dsh-emacs-test-connection-subdirectory-distinguishes-empty-and-unknown ()
  :tags '(dsh-unit)
  (let ((dsh-emacs--connection-session-status 'ready)
        (address (dsh-protocol-subagent-address-create "root" "child" "thread"))
        cell)
    (cl-letf (((symbol-function 'dsh-emacs-subagent--cell)
               (lambda (parent key)
                 (should (equal parent "root"))
                 (should (eq key 'subagentCatalog)) cell)))
      (should-error (dsh-emacs-session-exists-p "child" address)
                    :type 'dsh-emacs-session-state-unavailable)
      (setq cell (dsh-protocol-subagent-cell--from-alist
                  '((key . "subagentCatalog") (value . []))))
      (should-not (dsh-emacs-session-exists-p "child" address))
      (setq cell (dsh-protocol-subagent-cell--from-alist
                  '((key . "subagentCatalog") (value . [((id . "child"))]))))
      (should (dsh-emacs-session-exists-p "child" address)))))

(ert-deftest dsh-emacs-test-connection-snapshot-copies-nested-container-values ()
  :tags '(dsh-unit)
  (let* ((table (make-hash-table :test 'equal))
         (dsh-emacs--connection-status 'failed)
         (dsh-emacs--connection-error (list :message (vector table))))
    (puthash "key" (list "value") table)
    (let* ((snapshot (dsh-emacs-connection-state))
           (copy (aref (plist-get (plist-get snapshot :error) :message) 0)))
      (aset (car (gethash "key" copy)) 0 ?X)
      (puthash "extra" t copy)
      (should (equal (gethash "key" table) '("value")))
      (should-not (gethash "extra" table)))))

(ert-deftest dsh-emacs-test-connection-created-notification-actions-expire ()
  :tags '(dsh-unit)
  (require 'notifications)
  (dolist (backend '(darwin gnu/linux))
    (dsh-test--connection-environment
     (lambda ()
       (let ((system-type backend)
             (dsh-emacs--connection-status 'initial)
             (dsh-emacs-base-url "http://user:password@a.example")
             (dsh-emacs-enable-notifications t)
             (dsh-emacs--sessions (list (dsh-protocol-session--from-alist
                                         '((sessionId . "same-id")))))
             (original-featurep (symbol-function 'featurep))
             (opened 0) action form)
         (cl-letf (((symbol-function 'w32-notification-notify) nil)
                   ((symbol-function 'ns-do-applescript) nil)
                   ((symbol-function 'dsh-emacs-notify--visible-p) #'ignore)
                   ((symbol-function 'dsh-emacs-notify--server-p) (lambda () t))
                   ((symbol-function 'featurep)
                    (lambda (feature &optional subfeature)
                      (or (eq feature 'dbusbind) (funcall original-featurep feature subfeature))))
                   ((symbol-function 'executable-find) (lambda (name) (concat "/test/" name)))
                   ((symbol-function 'shell-quote-argument)
                    (lambda (text)
                      (when (string-prefix-p "(dsh-emacs-notify--open" text) (setq form text))
                      text))
                   ((symbol-function 'start-process) #'ignore)
                   ((symbol-function 'notifications-notify)
                    (lambda (&rest args) (setq action (plist-get args :on-action))))
                   ((symbol-function 'display-graphic-p) #'ignore)
                   ((symbol-function 'dsh-emacs-open-session)
                    (lambda (id) (should (equal id "same-id")) (cl-incf opened))))
           ;; Creation buffer disappears before the click, as with desktop actions.
           (with-temp-buffer (dsh-emacs-notify--post "same-id" "Finished"))
           (when form
             (should-not (string-match-p "a.example\\|password" form))
             (setq action (lambda (&rest _) (eval (read form) t))))
           (should (functionp action))
           (funcall action 1 "default")
           (should (= opened 1))
           ;; Same id on B and then back on A cannot revive the original action.
           (setq dsh-emacs-base-url "http://b.example")
           ;; Editing a legacy endpoint does not advance the generation.
           (funcall action 1 "default")
           (should (= opened 1))
           (cl-incf dsh-emacs--server-generation)
           (funcall action 1 "default")
           (setq dsh-emacs-base-url "http://a.example")
           (cl-incf dsh-emacs--server-generation)
           (funcall action 1 "default")
           (should (= opened 1))
           ;; A new Emacs instance may start again at the original generation.
           (let ((dsh-emacs--connection-instance "another-instance")
                 (dsh-emacs--server-generation 0))
             (funcall action 1 "default"))
           (should (= opened 1))))))))

(ert-deftest dsh-emacs-test-connection-preflight-protects-local-work ()
  :tags '(dsh-unit)
  (dsh-test--connection-environment
   (lambda ()
