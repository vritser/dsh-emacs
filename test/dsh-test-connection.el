(ert-deftest dsh-emacs-test-connection-cancels-read-and-owned-timer ()
  :tags '(dsh-unit)
  (dsh-test--connection-environment
   (lambda ()
     (let ((dsh-emacs--connection-status 'initial)
           response received timer (calls 0))
       (cl-letf (((symbol-function 'dsh-emacs--server-auth-header) #'ignore)
                 ((symbol-function 'url-retrieve)
                  (lambda (_url callback &rest _)
                    (setq received callback response (generate-new-buffer " *owned-read*")))))
         (dsh-emacs--rpc-async "session/list" nil (lambda (&rest _) (cl-incf calls)))
         (setq timer (dsh-emacs--server-run-later 3600 nil (lambda () (cl-incf calls))))
         (should-not (dsh-emacs-disconnect))
         (should-not (buffer-live-p response))
         (should-not (memq timer timer-list))
         (should-not dsh-emacs--server-requests)
         (with-temp-buffer (funcall received nil))
         (apply (timer--function timer) (timer--args timer))
         (should (= calls 0)))))))

(ert-deftest dsh-emacs-test-connection-old-notifications-and-buffer-cannot-act ()
