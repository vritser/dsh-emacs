;;; dsh-test-connection.el --- Connection lifecycle tests -*- lexical-binding: t; -*-
;; Package-Requires: ((emacs "28.1"))
(require 'dsh-test-support)

(ert-deftest dsh-emacs-test-connection-rejects-unsent-content ()
  :tags '(dsh-unit)
  (with-temp-buffer
    (dsh-emacs-mode)
    (insert "unsent draft")
    (let ((generation dsh-emacs--server-generation)
          (text (buffer-string)))
      (should-error (dsh-emacs-disconnect) :type 'user-error)
      (should (= generation dsh-emacs--server-generation))
      (should (equal text (buffer-string))))))

(ert-deftest dsh-emacs-test-connection-token-conflict-is-side-effect-free ()
  :tags '(dsh-unit)
  (let ((before (dsh-emacs-connection-state)))
    (should-error (dsh-emacs-connect "http://localhost:3080/?token=url-token"
                                     :token "other-token") :type 'user-error)
    (should (equal before (dsh-emacs-connection-state)))))

(ert-deftest dsh-emacs-test-connection-snapshot-is-deep-copy ()
  :tags '(dsh-unit)
  (let* ((dsh-emacs--connection-status 'connected)
         (dsh-emacs--connection-endpoint "http://localhost:3080")
         (dsh-emacs--connection-session-status 'ready)
         (dsh-emacs--sessions
          (list (dsh-protocol-session--from-alist '((sessionId . "session-A"))))))
    (let* ((snapshot (dsh-emacs-session-snapshot))
           (item (car (plist-get snapshot :sessions))))
      (aset (dsh-protocol-session-session-id item) 0 ?X)
      (should (equal (dsh-protocol-session-session-id (car dsh-emacs--sessions))
                     "session-A")))
    (should (dsh-emacs-session-exists-p "session-A"))
    (should-not (dsh-emacs-session-exists-p "missing"))
    (setq dsh-emacs--connection-session-status 'stale)
    (should-error (dsh-emacs-session-exists-p "session-A")
                  :type 'dsh-emacs-session-state-unavailable)))

(defun dsh-test--connection-environment (function)
  "Run FUNCTION with isolated lifecycle state and clean up its new buffers."
  (let ((dsh-emacs-base-url "http://a.example")
        (dsh-emacs--server-generation 0)
        (dsh-emacs--connection-status 'disconnected)
        (dsh-emacs--connection-base nil)
        (dsh-emacs--connection-endpoint nil)
        (dsh-emacs--connection-error nil)
        (dsh-emacs--connection-cleanup-needed nil)
        (dsh-emacs--connection-session-status 'unknown)
        (dsh-emacs--connection-attempt nil)
        (dsh-emacs--connection-retiring nil)
        (dsh-emacs--server-requests nil)
        (dsh-emacs--server-work-owner nil)
        (dsh-emacs--server-process nil)
        (dsh-emacs--server-auth-cookie nil)
        (dsh-emacs--server-alive-check nil)
        (dsh-emacs--sessions nil) (dsh-emacs--workspaces nil)
        (dsh-emacs--agent-presets nil) (dsh-emacs--archived-sessions nil)
        (dsh-emacs--current-session nil) (dsh-emacs--current-buffer nil)
        (dsh-emacs--chat-buffers (make-hash-table :test 'equal))
        (dsh-emacs--tool-calls (make-hash-table :test 'equal))
        (dsh-emacs--activity-groups (make-hash-table :test 'equal))
        (dsh-emacs--subagent-catalogs (make-hash-table :test 'equal))
        (dsh-emacs--subagent-generation 0)
        (dsh-emacs--subagent-host-live nil)
        (dsh-emacs--subagent-summary-request nil)
        (dsh-emacs--input-history-by-session (make-hash-table :test 'equal))
        (dsh-emacs--command-catalogs nil) (dsh-emacs--command-fetch-inflight nil)
        (dsh-emacs--command-fetch-stamps nil) (dsh-emacs--command-fetch-generation 0)
        (dsh-emacs--skill-catalogs nil) (dsh-emacs--skill-fetch-inflight nil)
        (dsh-emacs--skill-fetch-stamps nil) (dsh-emacs--skill-fetch-generation 0)
        (dsh-emacs-events--retiring-processes nil)
        (dsh-emacs-events--host-process nil) (dsh-emacs-events--host-ready nil)
        (dsh-emacs-events--host-reconnect-timer nil) (dsh-emacs-events--client-id nil)
        (dsh-emacs-events--snapshot-model-slots nil)
        (dsh-emacs--host-refresh-depth 0) (dsh-emacs--host-refresh-frames nil)
        (dsh-emacs--question-queue nil) (dsh-emacs--approval-queue nil)
        (dsh-emacs--session-list-fetch-generation 0)
        (buffers (buffer-list)))
    (unwind-protect (funcall function)
      (when dsh-emacs--connection-attempt
        (dsh-emacs--connection-release-attempt dsh-emacs--connection-attempt))
      (dolist (request (copy-sequence dsh-emacs--server-requests))
        (funcall (plist-get request :cancel)))
      (dolist (buffer (cl-set-difference (buffer-list) buffers))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer (setq kill-buffer-query-functions nil))
          (kill-buffer buffer))))))

(ert-deftest dsh-emacs-test-connection-entry-reconnects-after-disconnect ()
  :tags '(dsh-unit)
  (dsh-test--connection-environment
   (lambda ()
     (with-temp-buffer
       (let ((dsh-emacs-base-url "http://127.0.0.1:38080")
             (dsh-emacs-server-auth-token "unrelated-saved-token")
             (origin (current-buffer))
             auth initialize response request-url displayed)
         (dsh-emacs-disconnect)
         (cl-letf (((symbol-function 'dsh-emacs--project-root)
                    (lambda (_) "/tmp/entry-project/"))
                   ((symbol-function 'url-retrieve)
                    (lambda (url callback &rest _)
                      (setq auth callback request-url url
                            response (generate-new-buffer " *entry-auth*"))))
                   ((symbol-function 'dsh-emacs--connection-initialize)
                    (lambda (callback) (setq initialize callback)))
                   ((symbol-function 'dsh-emacs-list-sessions-display)
                    (lambda (root)
                      (push (list root (current-buffer)
                                  dsh-emacs--connection-status) displayed))))
           (let ((noninteractive nil) (executing-kbd-macro t))
             (call-interactively #'dsh-emacs))
           (should (equal request-url "http://127.0.0.1:38080/"))
           (should (eq dsh-emacs--connection-status 'connecting))
           (should-not displayed)
           (should-error
            (let ((noninteractive nil)) (call-interactively #'dsh-emacs))
            :type 'user-error)
           (with-current-buffer response
             (setq-local url-http-response-status 303)
             (insert "HTTP/1.1 303\nSet-Cookie: dsh-auth-test=fresh\n\n")
             (funcall auth nil))
           (should-not displayed)
           (funcall initialize t)
           (should (equal displayed
                          (list (list "/tmp/entry-project/" origin 'connected))))
           (should (eq (plist-get (dsh-emacs-session-snapshot) :status)
                       'ready))))))))

(ert-deftest dsh-emacs-test-connection-entry-retries-failed-target ()
  :tags '(dsh-unit)
  (dsh-test--connection-environment
   (lambda ()
     (with-temp-buffer
       (let ((dsh-emacs-base-url "http://b.example")
             (dsh-emacs--connection-status 'failed)
             auth response requests displayed)
         (cl-letf (((symbol-function 'url-retrieve)
                    (lambda (url callback &rest _)
                      (push url requests)
                      (setq auth callback
                            response (generate-new-buffer " *entry-retry*"))))
                   ((symbol-function 'dsh-emacs--connection-initialize)
                    (lambda (callback) (funcall callback t)))
                   ((symbol-function 'dsh-emacs-list-sessions-display)
                    (lambda (_) (setq displayed t))))
           (let ((noninteractive nil)) (call-interactively #'dsh-emacs))
           (with-current-buffer response
             (setq-local url-http-response-status 403)
             (funcall auth nil))
           (should (eq dsh-emacs--connection-status 'failed))
           (should-not displayed)
           (let ((noninteractive nil)) (call-interactively #'dsh-emacs))
           (with-current-buffer response
             (setq-local url-http-response-status 200)
             (funcall auth nil))
           (should (equal requests '("http://b.example/" "http://b.example/")))
           (should (eq dsh-emacs--connection-status 'connected))
           (should displayed)))))))

(ert-deftest dsh-emacs-test-connection-entry-keeps-background-work-offline ()
  :tags '(dsh-unit)
  (dsh-test--connection-environment
   (lambda ()
     (with-temp-buffer
       (let ((requests 0))
         (cl-letf (((symbol-function 'url-retrieve)
                    (lambda (&rest _) (cl-incf requests))))
           (dolist (status '(disconnected failed))
             (setq dsh-emacs--connection-status status)
             (should-error (dsh-emacs) :type 'user-error)
             (should-error (dsh-emacs-list-sessions) :type 'user-error)
             (let ((dsh-emacs--server-work-owner '(0 . "http://a.example"))
                   (noninteractive nil))
               (should-error (call-interactively #'dsh-emacs) :type 'user-error))
             (let ((dsh-emacs--server-buffer-owner '(0 . "http://a.example"))
                   (noninteractive nil))
               (should-error (call-interactively #'dsh-emacs) :type 'user-error))
             (should (eq dsh-emacs--connection-status status)))
           (let ((dsh-emacs--connection-cleanup-needed t)
                 (noninteractive nil))
             (should-error (call-interactively #'dsh-emacs) :type 'user-error))
           (should (= requests 0))
           (should-not dsh-emacs--connection-attempt)))))))

(ert-deftest dsh-emacs-test-connection-waits-for-initialization-and-redacts ()
  :tags '(dsh-unit)
  (dsh-test--connection-environment
   (lambda ()
     (with-temp-buffer
       (let ((dsh-emacs-server-auth-token "unrelated-saved-token")
             (calls 0) auth initialize response request-url)
         (cl-letf (((symbol-function 'url-retrieve)
                    (lambda (url callback &rest _)
                      (setq auth callback request-url url
                            response (generate-new-buffer " *connection-auth*"))))
                   ((symbol-function 'dsh-emacs--connection-initialize)
                    (lambda (callback) (setq initialize callback))))
           (dsh-emacs-connect "http://user:password@a.example/?token=explicit"
                              :callback (lambda (ok state)
                                          (cl-incf calls)
                                          (should ok)
                                          (should-error (dsh-emacs-disconnect) :type 'user-error)
                                          (should (eq (plist-get state :status) 'connected))))
           (should (string-suffix-p "/?token=explicit" request-url))
           (should-not (string-match-p "password\\|explicit"
                                       (prin1-to-string (dsh-emacs-connection-state))))
           (should-error (dsh-emacs-connect "http://b.example") :type 'user-error)
           (with-current-buffer response
             (setq-local url-http-response-status 303)
             (insert "HTTP/1.1 303\nSet-Cookie: dsh-auth-test=fresh\n\n")
             (funcall auth nil))
           (should (= calls 0))
           (should (eq dsh-emacs--connection-status 'connecting))
           (funcall initialize t)
           (funcall initialize t)
           (should (= calls 1))
           (should (equal dsh-emacs--server-auth-cookie "dsh-auth-test=fresh"))
           (should (eq (plist-get (dsh-emacs-session-snapshot) :status) 'ready))
           (should-not (dsh-emacs-session-exists-p "missing"))
           (should-not (dsh-emacs-disconnect))
           (should-not dsh-emacs--server-auth-cookie)
           (should-not (dsh-emacs-disconnect))))))))

(ert-deftest dsh-emacs-test-connection-cancel-notifies-after-return-without-changing-new-state ()
  :tags '(dsh-unit)
  (dsh-test--connection-environment
   (lambda ()
     (with-current-buffer (generate-new-buffer " *connection-origin*")
       (let (received response notifications)
         (cl-letf (((symbol-function 'url-retrieve)
                    (lambda (_url callback &rest _)
                      (setq received callback
                            response (generate-new-buffer " *connection-cancel*")))))
           (dsh-emacs-connect "http://a.example" :token nil
                              :callback (lambda (ok result)
                                          (let ((generation dsh-emacs--server-generation))
                                            (should-error (dsh-emacs-disconnect) :type 'user-error)
                                            (should (= generation dsh-emacs--server-generation)))
                                          (push (list ok result dsh-emacs--connection-status)
                                                notifications)))
           (dsh-emacs-disconnect)
           (should-not notifications)
           (should-not (buffer-live-p response))
           (dsh-emacs-connect "http://b.example" :token nil)
           (accept-process-output nil 0.01)
           (should (= (length notifications) 1))
           (should (equal (caar notifications) nil))
           (should (eq (plist-get (cadar notifications) :code) 'cancelled))
           (should (eq dsh-emacs--connection-status 'connecting))
           (should (equal dsh-emacs-base-url "http://b.example"))
           ;; A physically late authentication callback from the new attempt
           ;; is irrelevant after the origin dies.
           (let ((origin (current-buffer)))
             (kill-buffer origin)
             (should (eq dsh-emacs--connection-status 'failed))
             (should (eq (plist-get dsh-emacs--connection-error :code) 'origin-closed)))
           (should-not (buffer-live-p response))
           (should (functionp received))))))))

(ert-deftest dsh-emacs-test-connection-cleanup-failure-is-retryable-and-reentrant-safe ()
  :tags '(dsh-unit)
  (dsh-test--connection-environment
   (lambda ()
     (let ((attempts 0)
           (original (symbol-function 'dsh-emacs-command--disconnect)))
       (cl-letf (((symbol-function 'dsh-emacs-command--disconnect)
                  (lambda ()
                    (cl-incf attempts)
                    (should (eq (plist-get (dsh-emacs-connection-state) :status)
                                'disconnecting))
                    (should-error (dsh-emacs-disconnect) :type 'user-error)
                    (should-error (dsh-emacs-connect "http://b.example") :type 'user-error)
                    (if (= attempts 1) (error "cleanup test failure")
                      (funcall original)))))
         (should-error (dsh-emacs-disconnect) :type 'error)
         (let ((generation dsh-emacs--server-generation))
           (should dsh-emacs--connection-cleanup-needed)
           (should (eq dsh-emacs--connection-status 'failed))
           (should-error (dsh-emacs-connect "http://b.example") :type 'user-error)
           (should-not (dsh-emacs-disconnect))
           (should (= generation dsh-emacs--server-generation))
           (should-not dsh-emacs--connection-cleanup-needed)
           (should (= attempts 2))))))))

