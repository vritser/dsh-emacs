       (dolist (variable '(dsh-emacs--pending-attachments
                           dsh-emacs--creation-pending
                           dsh-emacs--pending-submissions
                           dsh-emacs--input-history-pending))
         (with-temp-buffer
           (dsh-emacs-mode)
           (set (make-local-variable variable)
                (if (eq variable 'dsh-emacs--input-history-pending) "recalled text" '(pending)))
           (let ((generation dsh-emacs--server-generation))
             (should-error (dsh-emacs-disconnect) :type 'user-error)
             (should (= generation dsh-emacs--server-generation))
             (should (symbol-value variable)))))))))

