(ert-deftest dsh-emacs-test-connection-loss-invalidates-both-entry-paths ()
  :tags '(dsh-unit)
  (dolist (status '(initial connected))
    (dsh-test--connection-environment
     (lambda ()
       (let* ((dsh-emacs--connection-status status)
              (dsh-emacs--connection-base "http://a.example")
              (dsh-emacs--connection-session-status 'ready)
              (dsh-emacs--sessions
               (list (dsh-protocol-session--from-alist '((sessionId . "old")))))
              (old (dsh-test--event-process :name "lost-core" :noquery t))
              (new (dsh-test--event-process :name "replacement-core" :noquery t))
              (dsh-emacs-events--host-process old)
              (fetches 0) response)
         (unwind-protect
             (cl-letf (((symbol-function 'dsh-emacs-events--host-schedule-reconnect) #'ignore)
                       ((symbol-function 'dsh-emacs-list-workspaces) #'ignore)
                       ((symbol-function 'dsh-emacs--rpc-async)
                        (lambda (_method _params callback)
                          (cl-incf fetches) (setq response callback))))
               (dsh-emacs-list-sessions--fetch)
               (should (= fetches 1))
               (dsh-emacs-events--host-lost old)
               (should (eq (plist-get (dsh-emacs-session-snapshot) :status) 'stale))
               (should-error (dsh-emacs-session-exists-p "old")
                             :type 'dsh-emacs-session-state-unavailable)
               ;; A pre-loss HTTP read cannot make the directory ready again.
               (with-current-buffer (get-buffer " *dsh-session-cache*")
                 (funcall response t '((items . [((sessionId . "old"))]))))
               (should (eq (plist-get (dsh-emacs-session-snapshot) :status) 'stale))
               (should-error (dsh-emacs-session-exists-p "old")
                             :type 'dsh-emacs-session-state-unavailable)
               (setq dsh-emacs-events--host-process new
                     dsh-emacs-events--host-ready t
                     dsh-emacs-events--client-id "new-client")
               (process-put new 'dsh-control-baseline t)
               (dsh-emacs-events--host-item new '((type . "unused")))
               (should (= fetches 1))
               (process-put new 'dsh-workspace-baseline t)
               (dsh-emacs-events--host-item new '((type . "unused")))
               (should (= fetches 2))
               (should (eq (plist-get (dsh-emacs-session-snapshot) :status) 'loading))
               (with-current-buffer (get-buffer " *dsh-session-cache*")
                 (funcall response t '((items . [((sessionId . "fresh"))]))))
               (should (eq (plist-get (dsh-emacs-session-snapshot) :status) 'ready))
               (should (dsh-emacs-session-exists-p "fresh"))
               (should-not (dsh-emacs-session-exists-p "old")))
           (delete-process old)
           (delete-process new)))))))

(ert-deftest dsh-emacs-test-connection-auth-response-cleanup-failure-retains-resource ()
  :tags '(dsh-unit)
  (dolist (failure '(refuse error))
    (dsh-test--connection-environment
     (lambda ()
       (let (response receive result (initialized 0) (calls 0))
         (unwind-protect
             (cl-letf (((symbol-function 'url-retrieve)
                        (lambda (_url callback &rest _)
                          (setq receive callback response (generate-new-buffer " *auth-failure*"))))
                       ((symbol-function 'dsh-emacs--connection-initialize)
                        (lambda (callback) (cl-incf initialized) (funcall callback t))))
               (dsh-emacs-connect "http://a.example" :token nil
                                  :callback (lambda (ok value)
                                              (setq result (cons ok value))
                                              (cl-incf calls)))
               (with-current-buffer response
                 (setq-local kill-buffer-query-functions
                             (list (lambda () (if (eq failure 'error) (error "cleanup failed") nil))))
                 (setq-local url-http-response-status 200)
                 (insert "HTTP/1.1 200\n\n")
                 (funcall receive nil))
               (should (= initialized 0))
               (should (= calls 1))
               (should-not (car result))
               (should (eq (plist-get (cdr result) :code) 'cleanup-failed))
               (should (eq dsh-emacs--connection-status 'failed))
               (should dsh-emacs--connection-cleanup-needed)
               (should (eq response (plist-get dsh-emacs--connection-attempt :response)))
               (should-error (dsh-emacs-connect "http://b.example") :type 'user-error)
               (with-current-buffer response (setq kill-buffer-query-functions nil))
               (dsh-emacs-disconnect)
               (accept-process-output nil 0.01)
               (should (= calls 1))
               (should-not (buffer-live-p response))
               (should (eq dsh-emacs--connection-status 'disconnected)))
           (when (buffer-live-p response)
             (with-current-buffer response (setq kill-buffer-query-functions nil)))))))))

(ert-deftest dsh-emacs-test-connection-attachment-read-cancels-with-disconnect ()
  :tags '(dsh-unit)
  (dsh-test--connection-environment
   (lambda ()
     (let ((dsh-emacs--connection-status 'initial) response (calls 0))
       (cl-letf (((symbol-function 'dsh-emacs--server-auth-header) #'ignore)
                 ((symbol-function 'url-retrieve)
                  (lambda (_url _callback &rest _)
                    (setq response (generate-new-buffer " *attachment-read*")))))
         (dsh-emacs--rpc-async "session/attachment" '((id . "image"))
                               (lambda (&rest _) (cl-incf calls)))
         (should (= (length dsh-emacs--server-requests) 1))
         (should-not (plist-get (car dsh-emacs--server-requests) :write))
         (dsh-emacs-disconnect)
         (should-not (buffer-live-p response))
         (should-not dsh-emacs--server-requests)
         (should (= calls 0)))))))

(ert-deftest dsh-emacs-test-connection-offline-server-start-and-restart ()
  :tags '(dsh-unit)
  (dsh-test--connection-environment
   (lambda ()
     (let ((launched 0) (dsh-emacs--server-alive-ttl 0))
       (cl-letf (((symbol-function 'dsh-emacs--server-bin) (lambda () "/test/dsh"))
                 ((symbol-function 'dsh-emacs--server-probe)
                  (lambda () (and dsh-emacs--server-process
                                  (process-live-p dsh-emacs--server-process))))
                 ((symbol-function 'dsh-emacs--server-launch)
                  (lambda (&rest _)
                    (cl-incf launched)
                    (setq dsh-emacs--server-process
                          (make-pipe-process :name "offline-managed" :noquery t))
                    (process-put dsh-emacs--server-process 'dsh-server-base dsh-emacs-base-url)
                    (dsh-emacs--server-invalidate-alive)))
                 ((symbol-function 'dsh-emacs--server-auth-ensure)
                  (lambda () (ert-fail "Starting offline must not authenticate a client")))
                 ((symbol-function 'dsh-emacs--server-auth-ensure-interactive)
                  (lambda () (ert-fail "Starting offline must not prompt for client auth"))))
         (unwind-protect
             (progn
               (dsh-emacs-disconnect)
               (dsh-emacs-server-stop)
               (should (dsh-emacs-server-start t))
               (should (= launched 1))
               (should (eq dsh-emacs--connection-status 'disconnected))
               (should-error (dsh-emacs--rpc-request "session/list" nil) :type 'user-error)
               (dsh-emacs-server-restart)
               (should (= launched 2))
               (should (process-live-p dsh-emacs--server-process))
               (should (eq dsh-emacs--connection-status 'disconnected))
               (dsh-emacs-server-stop)
               (setq dsh-emacs--connection-status 'failed)
               (should (dsh-emacs-server-start t))
               (should (= launched 3))
               (setq dsh-emacs--connection-cleanup-needed t)
               (should-error (dsh-emacs-server-start) :type 'user-error))
           (when (processp dsh-emacs--server-process)
             (delete-process dsh-emacs--server-process))))))))

(ert-deftest dsh-emacs-test-connection-persistent-stream-failure-allows-cleanup-retry ()
  :tags '(dsh-unit)
  (dsh-test--connection-environment
   (lambda ()
     (let* ((dsh-emacs--connection-status 'initial)
            (chat (generate-new-buffer " *broken-feature-chat*"))
            (process (dsh-test--event-process :name "broken-feature-stream" :noquery t))
            (attempts 0))
       (unwind-protect
           (progn
             (with-current-buffer chat
               (dsh-emacs-mode)
               (setq-local dsh-emacs--event-process process))
             (process-put process 'dsh-emacs-chat-buffer chat)
             (process-put process 'dsh-emacs-stream-handlers
                          (list (cons "broken" (cons "feature"
                                                     (lambda (_)
                                                       (cl-incf attempts)
                                                       (error "persistent failure"))))))
             (should-error (dsh-emacs-disconnect) :type 'error)
             (should dsh-emacs--connection-cleanup-needed)
             (should (= attempts 1))
             (dsh-emacs-disconnect)
             (should (= attempts 2))
             (should-not (buffer-live-p chat))
             (should-not dsh-emacs--connection-cleanup-needed)
             (cl-letf (((symbol-function 'url-retrieve)
                        (lambda (&rest _) (generate-new-buffer " *fresh-auth*"))))
               (dsh-emacs-connect "http://b.example" :token nil)
               (should (eq dsh-emacs--connection-status 'connecting))
               (dsh-emacs-disconnect)))
         (set-process-sentinel process #'ignore)
         (delete-process process))))))

